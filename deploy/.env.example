# 复制为 deploy/.env 并填写。这个文件包含密钥，不要提交到 git！

# ---------- 企业微信（管理后台 → 我的企业 / 应用管理 → 自建应用） ----------
WECOM_CORP_ID=ww0000000000000000          # 我的企业 → 企业ID
WECOM_AGENT_ID=1000002                     # 自建应用的 AgentId
WECOM_APP_SECRET=                          # 自建应用的 Secret
WECOM_CALLBACK_TOKEN=                      # 自建应用 → 接收消息 → API接收 里的 Token
WECOM_ENCODING_AES_KEY=                    # 同上，EncodingAESKey（43 位）
OWNER_USERID=                              # 你自己在企业微信里的账号（通讯录 → 点自己 → 账号）

# ---------- 多个自建应用（可选） ----------
# 主应用默认处理全部项目；只想让它处理部分项目时填项目 id（逗号分隔）
# WECOM_PROJECTS=bidagent
# 再加应用：列出渠道名（小写字母/数字），每个渠道配一组 WECOM_<渠道名大写>_*。
# 回调 URL 填 https://你的域名/wecom/callback/<渠道名>
# WECOM_APPS=dx
# WECOM_DX_NAME=智能党校
# WECOM_DX_AGENT_ID=1000003
# WECOM_DX_APP_SECRET=
# WECOM_DX_CALLBACK_TOKEN=
# WECOM_DX_ENCODING_AES_KEY=
# WECOM_DX_PROJECTS=party-school-ai      # 这个应用只处理这些项目

# ---------- 智能机器人：拉进群里，@ 它干活（可选） ----------
# 企业微信后台「智能机器人」→ API 模式选「长连接」，拿到 BotID 和 Secret（不需要回调地址）
# WECOM_BOTS=dxbot
# WECOM_DXBOT_NAME=党校助手
# WECOM_DXBOT_BOT_ID=
# WECOM_DXBOT_SECRET=
# WECOM_DXBOT_PROJECTS=party-school-ai
# WECOM_DXBOT_NOTIFY_APP=dx              # 需要你处理的消息再私信到这个应用，保证有推送

# ---------- 阿里云百炼（不填则使用简单规则匹配项目） ----------
DASHSCOPE_API_KEY=sk-xxxxxxxx
QWEN_MODEL=qwen-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 家里电脑 Agent ----------
# 随机生成一个长字符串，家里电脑的 config.yaml 里填同一个值。生成方法：
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=

# ---------- 其他 ----------
PUBLIC_BASE_URL=https://bot.example.com    # 你备案过的域名
DATA_DIR=/opt/auto-response/data
MERGE_WINDOW_SECONDS=15                    # 连续消息合并等待秒数
FILE_LINK_TTL_HOURS=168                    # 下载链接有效期
AGENT_OFFLINE_ALERT_MINUTES=10             # 家里电脑离线多久后提醒你
