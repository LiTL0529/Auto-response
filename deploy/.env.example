# 复制为 deploy/.env 并填写。这个文件包含密钥，不要提交到 git！

# ---------- 企业微信（管理后台 → 我的企业 / 应用管理 → 自建应用） ----------
WECOM_CORP_ID=ww0000000000000000          # 我的企业 → 企业ID
WECOM_AGENT_ID=1000002                     # 自建应用的 AgentId
WECOM_APP_SECRET=                          # 自建应用的 Secret
WECOM_CALLBACK_TOKEN=                      # 自建应用 → 接收消息 → API接收 里的 Token
WECOM_ENCODING_AES_KEY=                    # 同上，EncodingAESKey（43 位）
OWNER_USERID=                              # 你自己在企业微信里的账号（通讯录 → 点自己 → 账号）

# ---------- 阿里云百炼（不填则使用简单规则匹配项目） ----------
DASHSCOPE_API_KEY=sk-xxxxxxxx
QWEN_MODEL=qwen-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 家里电脑 Agent ----------
# 随机生成一个长字符串，家里电脑的 config.yaml 里填同一个值。生成方法：
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=

# ---------- 其他 ----------
PUBLIC_BASE_URL=https://bot.example.com    # 你备案过的域名
DATA_DIR=/opt/auto-response/data
MERGE_WINDOW_SECONDS=15                    # 连续消息合并等待秒数
FILE_LINK_TTL_HOURS=168                    # 下载链接有效期
AGENT_OFFLINE_ALERT_MINUTES=10             # 家里电脑离线多久后提醒你
